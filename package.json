{
  "name": "vault-flows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "powershell -ExecutionPolicy Bypass -File .\\start_https_dev.ps1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:node": "node --test src/**/*.test.js src/*.test.js",
    "bridge:local": "python run_local_runtime_bridge.py",
